# Локализация системы передачи предмета (ItemOffer)
# Все попапы и сообщения для alert'а.

# === Попапы предложения (клик ЛКМ по цели) ===

item-offer-to-giver = You hand over the item to {$target}.
item-offer-to-target = {$giver} wants to hand you an item. Click the gift icon to accept.

# === Попапы успеха (клик по alert'у) ===

item-offer-success-to-giver = {$receiver} accepted your item ({$item}).
item-offer-success-to-target = {$giver} handed you {$item}.

# === Попапы ошибок ===

item-offer-fail-no-mode = Enter item offer mode first (press F).
item-offer-fail-self = You can't hand an item to yourself.
item-offer-fail-no-hands = You have no hands.
item-offer-fail-no-item = There is no item in your active hand.
item-offer-fail-no-free-hand = {$target}'s hands are full.
item-offer-fail-out-of-range = {$target} is too far away.
item-offer-fail-item-lost = Offer cancelled: the item is no longer in your hands.
item-offer-fail-target-lost = Offer cancelled: target is too far away.
item-offer-fail-timeout = Offer timed out.

# === Прочее ===

item-offer-superseded = Your offer was superseded by another ({$item}).
item-offer-unknown-item = unknown item

# === Alert name/description ===

alerts-item-offer-name = Item Handover
alerts-item-offer-desc = Someone wants to hand you an item.
